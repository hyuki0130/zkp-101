# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy source files (excluding symlinks and build artifacts)
COPY frontend/*.js frontend/*.html frontend/vite.config.js ./
COPY frontend/*.json ./

# Create target directory and copy circuit file
RUN mkdir -p target
COPY target/advanced.json ./target/advanced.json

# Build the application
RUN npm run build

# Stage 2: Production with HTTPS
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy HTTPS nginx configuration
COPY frontend/nginx-https.conf /etc/nginx/conf.d/default.conf

# Expose HTTPS port
EXPOSE 443
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-check-certificate --quiet --tries=1 --spider https://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
