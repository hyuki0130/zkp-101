// Simple User Address Ownership Proof
// Matches the signature generation logic from index.js

use dep::std;
use dep::keccak256::keccak256;

// Helper: Concatenate public key coordinates (x || y)
fn concat_pubkey(pubkey_x: [u8; 32], pubkey_y: [u8; 32]) -> [u8; 64] {
    let mut out: [u8; 64] = [0; 64];
    for i in 0..32 {
        out[i] = pubkey_x[i];
        out[i + 32] = pubkey_y[i];
    }
    out
}

fn main(
    // ============ Public Inputs ============
    user_address: pub [u8; 20],         // Public: User address

    // ============ Private Inputs ============
    user_signature: [u8; 64],           // Private: Signature (r || s)
    user_pubkey_x: [u8; 32],            // Private: Public key X coordinate
    user_pubkey_y: [u8; 32],            // Private: Public key Y coordinate
) {
    // Step 1: Generate Calldata (same as index.js generateCalldata)
    let function_selector: [u8; 4] = [0x56, 0xfe, 0xed, 0x5e];

    // Calldata = selector (4) + padding (12) + address (20) = 36 bytes
    let mut calldata: [u8; 36] = [0; 36];

    // Copy function selector
    for i in 0..4 {
        calldata[i] = function_selector[i];
    }

    // Skip 12 bytes padding (already 0)

    // Copy user address
    for i in 0..20 {
        calldata[16 + i] = user_address[i];
    }

    // Step 2: Calculate digest (keccak256(calldata))
    let digest: [u8; 32] = keccak256(calldata, 36);

    // Step 3: Convert to Ethereum Personal Sign format
    // Ethereum Personal Sign Prefix: "\x19Ethereum Signed Message:\n32"
    let eth_prefix: [u8; 28] = [
        0x19, 0x45, 0x74, 0x68, 0x65, 0x72, 0x65, 0x75,  // "\x19Ethereum"
        0x6d, 0x20, 0x53, 0x69, 0x67, 0x6e, 0x65, 0x64,  // " Signed"
        0x20, 0x4d, 0x65, 0x73, 0x73, 0x61, 0x67, 0x65,  // " Message"
        0x3a, 0x0a, 0x33, 0x32                            // ":\n32"
    ];

    let mut eth_message: [u8; 60] = [0; 60];
    for i in 0..28 {
        eth_message[i] = eth_prefix[i];
    }
    for i in 0..32 {
        eth_message[28 + i] = digest[i];
    }

    // Hash the Ethereum Personal Sign message
    let eth_message_hash: [u8; 32] = keccak256(eth_message, 60);

    // Step 4: Verify ECDSA signature
    let signature_valid = std::ecdsa_secp256k1::verify_signature(
        user_pubkey_x,
        user_pubkey_y,
        user_signature,
        eth_message_hash
    );

    assert(signature_valid, "Invalid signature");

    // Step 5: Derive address from public key
    // Concatenate pubkey (x || y)
    let pubkey_full = concat_pubkey(user_pubkey_x, user_pubkey_y);

    // Keccak256(pubkey)
    let pubkey_hash: [u8; 32] = keccak256(pubkey_full, 64);

    // Address = last 20 bytes
    let mut derived_address: [u8; 20] = [0; 20];
    for i in 0..20 {
        derived_address[i] = pubkey_hash[12 + i];
    }

    // Step 6: Verify address match
    assert(derived_address == user_address, "Public key does not match address");

    // Success! This proof guarantees:
    // 1. User owns the private key for user_address
    // 2. Calldata generation and signature are valid
    // 3. Public key matches the address
    //
    // Same logic as index.js:
    // - generateCalldata(userAddress)
    // - keccak256(calldata)
    // - signer.signMessage(digest) - Ethereum Personal Sign
    // - Public key recovery and verification
}
