// Coinbase Attestation Zero-Knowledge Verifier
// Full verification of Coinbase KYC attestation transaction

use dep::std;
use dep::keccak256::keccak256;

// Coinbase Attester Proxy address on Base Mainnet
// This is the contract that receives attestation requests and forwards them to EAS
global COINBASE_ATTESTER: [u8; 20] = [
    0x35, 0x74, 0x58, 0x73, 0x9F, 0x90, 0x46, 0x1b,
    0x99, 0x78, 0x93, 0x50, 0x86, 0x8C, 0xD7, 0xCF,
    0x33, 0x0D, 0xd7, 0xEE
];

// Helper: Concatenate public key coordinates (x || y)
fn concat_pubkey(pubkey_x: [u8; 32], pubkey_y: [u8; 32]) -> [u8; 64] {
    let mut out: [u8; 64] = [0; 64];
    for i in 0..32 {
        out[i] = pubkey_x[i];
        out[i + 32] = pubkey_y[i];
    }
    out
}

// Helper: Extract 'to' address from RLP decoded transaction
// Assumes standard Ethereum transaction structure
fn extract_to_address(raw_tx: [u8; 300]) -> [u8; 20] {
    // This is a simplified extraction
    // In production, use proper RLP decoding library
    // For EIP-1559 transactions (type 2):
    // Format: 0x02 || rlp([chainId, nonce, maxPriorityFeePerGas, maxFeePerGas, gasLimit, to, value, data, accessList, signatureYParity, signatureR, signatureS])

    // For Coinbase attestation transactions, the 'to' address is at byte index 23
    // This is after: type(1) + rlp_header(2) + chainId + nonce + maxPriorityFee + maxFeePerGas + gasLimit + to_marker(1)
    let mut to_address: [u8; 20] = [0; 20];

    // Extract 20 bytes starting from index 23
    for i in 0..20 {
        to_address[i] = raw_tx[23 + i];
    }

    to_address
}


// Helper: Extract recipient address from calldata
// EAS attest() function encodes recipient in the request struct
fn extract_recipient_from_calldata(raw_tx: [u8; 300]) -> [u8; 20] {
    // This is a simplified extraction
    // In production, use proper RLP + ABI decoding
    // TODO: Implement proper calldata parsing

    let mut recipient: [u8; 20] = [0; 20];

    // For Coinbase attestation transaction, recipient is at byte index 61
    let offset = 61;

    for i in 0..20 {
        recipient[i] = raw_tx[offset + i];
    }

    recipient
}

// Helper: Extract address from calldata input
// Calldata format: 4 bytes selector + 12 bytes padding + 20 bytes address
fn extract_address_from_calldata(calldata: [u8; 36]) -> [u8; 20] {
    let mut address: [u8; 20] = [0; 20];

    // Address starts at byte 16 (4 bytes selector + 12 bytes padding)
    for i in 0..20 {
        address[i] = calldata[16 + i];
    }

    address
}


// Helper: Create Ethereum Personal Sign message hash
// Ethereum Personal Sign format: "\x19Ethereum Signed Message:\n32" + hash
fn create_eth_signed_message_hash(digest: [u8; 32]) -> [u8; 32] {
    // Ethereum Personal Sign prefix: "\x19Ethereum Signed Message:\n32"
    let prefix: [u8; 26] = [
        0x19, 0x45, 0x74, 0x68, 0x65, 0x72, 0x65, 0x75, 0x6d, 0x20,
        0x53, 0x69, 0x67, 0x6e, 0x65, 0x64, 0x20, 0x4d, 0x65, 0x73,
        0x73, 0x61, 0x67, 0x65, 0x3a, 0x0a
    ];

    // Length "32" as ASCII
    let length: [u8; 2] = [0x33, 0x32]; // "32"

    // Concatenate: prefix + length + digest = 26 + 2 + 32 = 60 bytes
    let mut message: [u8; 60] = [0; 60];

    // Copy prefix
    for i in 0..26 {
        message[i] = prefix[i];
    }

    // Copy length
    for i in 0..2 {
        message[26 + i] = length[i];
    }

    // Copy digest
    for i in 0..32 {
        message[28 + i] = digest[i];
    }

    // Hash the full message
    keccak256(message, 60)
}

fn main(
    // ============ Public Inputs ============
    // These values are visible in the proof and can be verified on-chain
    user_address: pub [u8; 20],         // User's Ethereum address (attestation recipient)
    tx_hash: pub [u8; 32],              // Transaction hash to verify
    tx_length: pub u32,                 // Actual length of the transaction (for proper hashing)

    // ============ Private Inputs ============
    // These values are hidden in the proof (zero-knowledge)
    raw_transaction: [u8; 300],         // RLP-encoded raw transaction (padded to 300 bytes)
    calldata: [u8; 36],                 // attest(address) calldata
    user_signature: [u8; 64],           // User's signature on calldata digest
    user_pubkey_x: [u8; 32],            // User's public key X coordinate
    user_pubkey_y: [u8; 32],            // User's public key Y coordinate
) {
    // ===================================================================
    // PART 1: User Authorization Verification
    // ===================================================================
    // First verify that the user authorized this attestation request

    // ===================================================================
    // Step 1: Verify Calldata Contains User Address
    // ===================================================================
    // Ensure the calldata is requesting attestation for the claimed user_address

    let calldata_address = extract_address_from_calldata(calldata);
    assert(calldata_address == user_address, "Calldata address does not match user address");

    // ===================================================================
    // Step 2: Derive Ethereum Address from Public Key
    // ===================================================================
    // Compute the Ethereum address from the provided public key
    // Ethereum address = last 20 bytes of keccak256(pubkey)

    let pubkey_full = concat_pubkey(user_pubkey_x, user_pubkey_y);
    let pubkey_hash: [u8; 32] = keccak256(pubkey_full, 64);

    // Extract last 20 bytes as Ethereum address
    let mut derived_address: [u8; 20] = [0; 20];
    for i in 0..20 {
        derived_address[i] = pubkey_hash[12 + i];
    }

    // ===================================================================
    // Step 3: Verify Public Key Ownership
    // ===================================================================
    // Ensure the provided public key actually belongs to the user_address

    assert(derived_address == user_address, "Public key does not match user address");

    // ===================================================================
    // Step 4: Verify User Signature on Calldata
    // ===================================================================
    // Verify that the user signed the calldata digest
    // This proves the user authorized this specific attestation request

    // Compute calldata digest (keccak256 of calldata)
    let calldata_digest: [u8; 32] = keccak256(calldata, 36);

    // Create Ethereum Personal Sign message hash
    let message_hash = create_eth_signed_message_hash(calldata_digest);

    // Verify signature using user's public key
    let signature_valid = std::ecdsa_secp256k1::verify_signature(
        user_pubkey_x,
        user_pubkey_y,
        user_signature,
        message_hash
    );
    assert(signature_valid, "Invalid user signature on calldata");

    // ===================================================================
    // PART 2: Transaction Verification
    // ===================================================================
    // Now verify the transaction details

    // ===================================================================
    // Step 5: Verify Transaction Hash Integrity
    // ===================================================================
    // Ensure that the provided raw transaction matches the claimed tx_hash
    // This prevents tampering with transaction data

    let computed_tx_hash: [u8; 32] = keccak256(raw_transaction, tx_length);
    assert(computed_tx_hash == tx_hash, "Transaction hash mismatch");

    // ===================================================================
    // Step 6: Verify Transaction Destination
    // ===================================================================
    // The transaction should be sent to Coinbase Attester contract

    let to_address = extract_to_address(raw_transaction);
    assert(to_address == COINBASE_ATTESTER, "Transaction not sent to Coinbase Attester");

    // ===================================================================
    // Step 7: Verify Transaction Recipient
    // ===================================================================
    // Extract recipient from the transaction calldata
    // Ensure the attestation recipient matches the claimed user_address

    let recipient = extract_recipient_from_calldata(raw_transaction);
    assert(recipient == user_address, "Recipient does not match user address");

    // ===================================================================
    // Verification Complete
    // ===================================================================
    //
    // This zero-knowledge proof verifies a Coinbase KYC attestation in two parts:
    //
    // PART 1: User Authorization (Steps 1-4)
    // - Calldata contains the correct user_address
    // - Public key derives to user_address (ownership proof)
    // - User signed the calldata digest (authorization proof)
    //
    // PART 2: Transaction Verification (Steps 5-7)
    // - Transaction hash matches raw transaction data
    // - Transaction was sent to Coinbase Attester contract
    // - Transaction recipient matches user_address
    //
    // Privacy guarantees:
    // - Raw transaction details remain private
    // - Calldata remains private
    // - User signature remains private
    // - User public key remains private
    //
    // Public outputs visible to verifier:
    // - user_address: Who received the attestation
    // - tx_hash: Which transaction created the attestation
    // - tx_length: Length of the transaction
    //
    // On-chain verification (Wrapper Contract responsibilities):
    // - Verify this ZKP proof using generated Verifier.sol
    // - Query EAS for attestation details (expiration, revocation)
    // - Check: if (expiration_time != 0) require(block.timestamp < expiration_time)
    // - Check: require(revocation_time == 0)
    // ===================================================================
}
