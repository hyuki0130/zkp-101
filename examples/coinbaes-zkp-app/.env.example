# Coinbase Attestation ZKP - 환경 변수 설정

# 배포할 지갑의 Private Key (MetaMask에서 추출)
# ⚠️ 보안 주의: 절대 GitHub에 커밋하지 마세요!
PRIVATE_KEY=0x...

# (선택) Basescan API Key (컨트랙트 검증용)
# https://basescan.org/myapikey 에서 발급
ETHERSCAN_API_KEY=...

# (선택) Base RPC URL
# Base Mainnet: https://mainnet.base.org (Chain ID: 8453)
# Base Sepolia: https://sepolia.base.org (Chain ID: 84532)
# 기본값: https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org

# 테스트넷 사용 시:
# BASE_RPC_URL=https://sepolia.base.org

# (선택) 배포자 지갑 주소 (참고용, 스크립트에서 자동 파생)
USER_ADDRESS=0x...
